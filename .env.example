# =============================================================================
# SERGIO — Editor de Video Ultra Profesional
# Variables de entorno (NUNCA commitear el .env real)
# =============================================================================

# -----------------------------------------------------------------------------
# IA / LLMs (obligatorio al menos uno)
# -----------------------------------------------------------------------------
# OpenRouter: paga solo lo que usas (~$0.002-0.01/llamada)
OPENROUTER_API_KEY=
# Google/Gemini: TIER GRATUITO (60 req/min) — ideal para bajo presupuesto
GEMINI_API_KEY=
GOOGLE_API_KEY=
# Opcionales:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Voz (TTS / STT)
# -----------------------------------------------------------------------------
# ElevenLabs: voz premium (~$5/mes starter)
ELEVENLABS_API_KEY=
# Deepgram: STT barato (~$0.0043/minuto)
DEEPGRAM_API_KEY=
# Kokoro: TTS LOCAL, GRATIS (no necesita API key)
KOKORO_ENABLED=1

# -----------------------------------------------------------------------------
# Video / Generación IA (opcionales — usar con moderación)
# -----------------------------------------------------------------------------
# Kling AI: generación de video (~$0.10-0.50/segundo)
KLING_API_KEY=
# Runway ML: (~$0.20-1.00/segundo)
RUNWAY_API_KEY=
# Pika Labs: (~$0.15-0.80/segundo)
PIKA_API_KEY=
# Luma Dream Machine
LUMA_API_KEY=

# -----------------------------------------------------------------------------
# Redes sociales / Publicación (opcional, requiere OAuth del usuario)
# -----------------------------------------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
TIKTOK_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Pagos (Stripe — para monetización del servicio)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Sergio Config
# -----------------------------------------------------------------------------
SERGIO_MODO=editor_video
SERGIO_PUBLIC_URL=
SERGIO_EDICION=publica
SERGIO_REGISTRO=abierto
SERGIO_CIFRAR=1
SERGIO_CLAVE_MAESTRA=

# Presupuesto IA ($ USD mensual por cliente)
SERGIO_MARGEN=0.40
SERGIO_MARGEN_GO=0.50
SERGIO_USO_TIPICO=0.35

# Rate limiting (EVITAR GASTOS EXCESIVOS — CRÍTICO para rentabilidad)
SERGIO_MAX_LLAMADAS_DIA=100
SERGIO_MAX_COSTO_DIA_USD=2.00
SERGIO_MAX_COSTO_MES_USD=15.00

# Almacenamiento: solo local (sin costos de cloud)
STORAGE_MODE=local
STORAGE_LOCAL_PATH=~/.sergio/media

# -----------------------------------------------------------------------------
# NOTAS DE RENTABILIDAD
# -----------------------------------------------------------------------------
# CÓMO MINIMIZAR COSTOS:
# 1. Prioriza Gemini (gratis 60 req/min) sobre OpenRouter para tareas simples
# 2. Usa Kokoro (local) para TTS en vez de ElevenLabs
# 3. Video Boost usa ffmpeg LOCAL (sin costo de API)
# 4. Limita generación de video con Kling/Runway a usuarios de pago
# 5. Deepgram solo para transcripción cuando sea necesario
#
# MODELO DE INGRESOS SUGERIDO:
# - Free: edición básica, boost 1080p, voz Kokoro
# - Pro ($9.99/mes): boost 4K, ElevenLabs voice, sin límites de llamadas
# - Studio ($29.99/mes): generación Kling/Runway, VFX avanzados, sin watermark
# - Pay-per-render: $0.50 por video con generación IA
# =============================================================================
