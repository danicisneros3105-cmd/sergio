msgstr "Guarda las claves, las comprueba y elige el modelo principal de Sergio en la nube."

#: sergio nube configurar --kimi
msgid "Kimi (Moonshot) API key."
msgstr "Clave de API de Kimi (Moonshot)."

#: sergio nube configurar --gemini
msgid "Gemini / Google API key."
msgstr "Clave de API de Gemini / Google."

#: sergio nube configurar --modelo
msgid "Force a model id (e.g. kimi-k2.6)."
msgstr "Fuerza un id de modelo (p. ej. kimi-k2.6)."

#: sergio nube configurar --tripo
