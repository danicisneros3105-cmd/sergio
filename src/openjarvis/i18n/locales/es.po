"Language: es\n"
"Project-Id-Version: sergio\n"

# Command help (--help)

#: sergio
msgid "Sergio — your personal assistant"
msgstr "Sergio — backend modular de asistente de IA"

#: sergio --version
msgid "Show the version and exit."
msgstr "Muestra la versión y sale."

#: sergio --verbose
msgid "Enable debug logging"
msgstr "Activa los registros de depuración"

#: sergio --quiet
msgid "Suppress non-error output"
msgstr "Oculta todo lo que no sea un error"

#: sergio --pick-model
msgid "Bare ``jarvis``: force interactive model list (overrides JARVIS_SKIP_MODEL_PICK)."
msgstr "``jarvis`` a secas: fuerza la lista interactiva de modelos (anula JARVIS_SKIP_MODEL_PICK)."

#: sergio _bootstrap
msgid "Internal helper used by install.sh — not for direct user invocation."
msgstr "Ayudante interno usado por install.sh; no es para usarlo directamente."

#: sergio _bootstrap --write-config
msgid "Render config.toml from detected hardware + provided engine/model."
msgstr "Genera config.toml a partir del hardware detectado y del motor/modelo indicados."

#: sergio _bootstrap --engine
msgid "Inference engine slug (e.g. ollama). Empty = auto-recommend."
msgstr "Motor de inferencia (p. ej. ollama). Vacío = recomendación automática."

#: sergio _bootstrap --model
msgid "Model id (e.g. qwen3.5:2b). Empty = auto-recommend."
msgstr "Id del modelo (p. ej. qwen3.5:2b). Vacío = recomendación automática."

#: sergio _bootstrap --prefer-cloud-when-available
msgid "If a known cloud-API key is in env, override engine/model to cloud."
msgstr "Si hay una clave de API de nube conocida en el entorno, usa ese motor/modelo en la nube."

#: sergio add
msgid "Add an MCP server configuration.\n\n    Quick setup for common MCP servers:\n\n      jarvis add github --key TOKEN\n      jarvis add filesystem\n      jarvis add slack --key TOKEN\n\n    Known servers: github, filesystem, slack, postgres, brave-search,\n    memory, puppeteer, google-maps"
msgstr "Añade la configuración de un servidor MCP.\n\n    Configuración rápida para servidores MCP comunes:\n\n      jarvis add github --key TOKEN\n      jarvis add filesystem\n      jarvis add slack --key TOKEN\n\n    Servidores conocidos: github, filesystem, slack, postgres, brave-search,\n    memory, puppeteer, google-maps"

#: sergio add --key
msgid "API key or token for the server."
msgstr "Clave de API o token del servidor."

#: sergio add --args
msgid "Additional arguments (comma-separated)."
msgstr "Argumentos adicionales (separados por comas)."

#: sergio agents
msgid "Manage persistent agents — create, inspect, chat, bind channels."
msgstr "Gestiona agentes persistentes: crear, inspeccionar, conversar, vincular canales."

#: sergio agents ask
msgid "Ask an agent a question (immediate response)."
msgstr "Hazle una pregunta a un agente (respuesta inmediata)."

#: sergio agents ask --yes
msgid "Auto-approve tool execution that would otherwise need confirmation. Default: on (suits non-interactive CLI use). Pass --no-yes to require a TTY prompt for tools whose ToolSpec sets requires_confirmation=True."
msgstr "Aprueba solo la ejecución de herramientas que pedirían confirmación. Por defecto: activado (útil en la CLI no interactiva). Usa --no-yes para pedir confirmación en la terminal a las herramientas cuyo ToolSpec tiene requires_confirmation=True."

#: sergio agents bind
msgid "Bind a channel to an agent."
msgstr "Vincula un canal a un agente."

#: sergio agents bind --slack
msgid "Slack channel (e.g. #research)"
msgstr "Canal de Slack (p. ej. #investigacion)"

#: sergio agents bind --telegram
msgid "Telegram chat ID"
msgstr "ID del chat de Telegram"

#: sergio agents bind --whatsapp
msgid "WhatsApp phone number"
msgstr "Número de teléfono de WhatsApp"

#: sergio agents channels
msgid "List channel bindings for an agent."
msgstr "Lista los canales vinculados a un agente."

#: sergio agents create
msgid "Create a new persistent agent."
msgstr "Crea un agente persistente nuevo."

#: sergio agents create --name
msgid "Agent name"
msgstr "Nombre del agente"

#: sergio agents create --template
msgid "Template ID to use"
msgstr "ID de la plantilla a usar"

#: sergio agents create --type
msgid "Agent type"
msgstr "Tipo de agente"

#: sergio agents daemon
msgid "Run the agent scheduler as a standalone daemon."
msgstr "Ejecuta el planificador de agentes como servicio independiente."

#: sergio agents delete
msgid "Archive (soft-delete) an agent."
msgstr "Archiva (borrado suave) un agente."

#: sergio agents errors
msgid "Show all agents in error or needs_attention state."
msgstr "Muestra los agentes con error o que necesitan atención."

#: sergio agents info
msgid "Show detailed info about a managed agent."
msgstr "Muestra información detallada de un agente gestionado."

#: sergio agents instruct
msgid "Queue an instruction for the agent's next tick."
msgstr "Pone en cola una instrucción para el próximo ciclo del agente."

#: sergio agents launch
msgid "Interactive agent launcher."
msgstr "Lanzador interactivo de agentes."

#: sergio agents learning
msgid "Show learning history or trigger a manual run."
msgstr "Muestra el historial de aprendizaje o lanza una ejecución manual."

#: sergio agents learning --run
msgid "Trigger manual learning run"
msgstr "Lanza una ejecución manual de aprendizaje"

#: sergio agents list
msgid "List all managed agents."
msgstr "Lista todos los agentes gestionados."

#: sergio agents logs
msgid "Show recent execution traces for an agent."
msgstr "Muestra las trazas de ejecución recientes de un agente."

#: sergio agents logs --limit
msgid "Number of recent traces to show"
msgstr "Cuántas trazas recientes mostrar"

#: sergio agents messages
msgid "Show message history with an agent."
msgstr "Muestra el historial de mensajes con un agente."

#: sergio agents pause
msgid "Pause an agent."
msgstr "Pausa un agente."

#: sergio agents recover
msgid "Recover an agent from its last checkpoint."
msgstr "Recupera un agente desde su último punto de control."

#: sergio agents resume
msgid "Resume a paused agent."
msgstr "Reanuda un agente pausado."

#: sergio agents run
msgid "Run one tick immediately for testing."
msgstr "Ejecuta un ciclo ahora mismo, para pruebas."

#: sergio agents search
msgid "Cross-session search across agent traces."
msgstr "Busca en las trazas de todos los agentes y sesiones."

#: sergio agents search --limit
msgid "Max results"
msgstr "Máximo de resultados"

#: sergio agents start
msgid "Start scheduling an agent."
msgstr "Empieza a programar un agente."

#: sergio agents status
msgid "Show all agents with schedule and run info."
msgstr "Muestra todos los agentes con su programación y ejecuciones."

#: sergio agents stop
msgid "Stop scheduling an agent."
msgstr "Deja de programar un agente."

#: sergio agents tasks
msgid "List tasks for an agent."
msgstr "Lista las tareas de un agente."

#: sergio agents templates
msgid "List available agent templates."
msgstr "Lista las plantillas de agente disponibles."

#: sergio agents trace
msgid "Show step-by-step trace of agent ticks."
msgstr "Muestra paso a paso la traza de los ciclos del agente."

#: sergio agents trace --run
msgid "Specific run number"
msgstr "Número de ejecución concreto"

#: sergio agents trace --limit
msgid "Number of traces to show"
msgstr "Cuántas trazas mostrar"

#: sergio agents watch
msgid "Live feed of agent activity."
msgstr "Actividad de los agentes en directo."

#: sergio approvals
msgid "List, approve or deny actions waiting for your approval."
msgstr "Lista, aprueba o rechaza acciones que esperan tu aprobación."

#: sergio approvals approve
msgid "Approve a pending action."
msgstr "Aprueba una acción pendiente."

#: sergio approvals deny
msgid "Deny a pending action."
msgstr "Rechaza una acción pendiente."

#: sergio approvals list
msgid "Show pending actions."
msgstr "Muestra las acciones pendientes."

#: sergio ask
msgid "Ask Jarvis a question."
msgstr "Hazle una pregunta a Sergio."

#: sergio ask -m
msgid "Model to use."
msgstr "Modelo a usar."

#: sergio ask -e
msgid "Engine backend."
msgstr "Motor de inferencia."

#: sergio ask -t
msgid "Sampling temperature (default: from config)."
msgstr "Temperatura de muestreo (por defecto: la de la configuración)."

#: sergio ask --max-tokens
msgid "Max tokens to generate (default: from config)."
msgstr "Máximo de tokens a generar (por defecto: el de la configuración)."

#: sergio ask --json
msgid "Output raw JSON result."
msgstr "Muestra el resultado en JSON tal cual."

#: sergio ask --no-stream
msgid "Kept for old scripts: answers already arrive in one piece."
msgstr "Se mantiene por compatibilidad: la respuesta ya llega completa."

#: sergio ask --no-context
msgid "Disable memory context injection."
msgstr "No añade contexto de la memoria."

#: sergio ask -a
msgid "Agent to use (simple, orchestrator, ...). When omitted, falls back to ``agent.default_agent`` from config. Pass ``--agent ''`` to force direct-to-engine mode (no agent)."
msgstr "Agente a usar (simple, orchestrator, ...). Si se omite, usa ``agent.default_agent`` de la configuración. Pasa ``--agent ''`` para hablar directamente con el motor (sin agente)."

#: sergio ask --tools
msgid "Comma-separated tool names to enable (e.g. calculator,think)."
msgstr "Herramientas a activar, separadas por comas (p. ej. calculator,think)."

#: sergio ask --profile
msgid "Print inference telemetry profile (latency, tokens, energy, IPW)."
msgstr "Muestra el perfil de telemetría de la inferencia (latencia, tokens, energía, IPW)."

#: sergio ask --research
msgid "Route the query through the hybrid-search research agent over the personal knowledge store (BM25 + dense embeddings, max 5 tool calls)."
msgstr "Pasa la pregunta por el agente de investigación de búsqueda híbrida sobre tu almacén de conocimiento personal (BM25 + embeddings densos, máximo 5 llamadas a herramientas)."

#: sergio ask --knowledge-db
msgid "Override the KnowledgeStore path used by --research (default: ~/.openjarvis/knowledge.db)."
msgstr "Cambia la ruta del KnowledgeStore que usa --research (por defecto: ~/.openjarvis/knowledge.db)."

#: sergio ask -i
msgid "Image file for a vision model (e.g. gemma3). Repeatable."
msgstr "Imagen para un modelo de visión (p. ej. gemma3). Se puede repetir."

#: sergio ask -S
msgid "Capture the current screen and send it to the vision model."
msgstr "Captura la pantalla actual y la envía al modelo de visión."

#: sergio ask --persona
msgid "Named persona dir under ~/.openjarvis/personas/<name>/ (overrides config). Pass 'none' to disable all persona files."
msgstr "Carpeta de persona en ~/.openjarvis/personas/<nombre>/ (anula la configuración). Pasa 'none' para desactivar todos los archivos de persona."

#: sergio ask --route
msgid "Routing policy to select model (e.g. heuristic, learned). Overrides config."
msgstr "Política de enrutamiento para elegir modelo (p. ej. heuristic, learned). Anula la configuración."

#: sergio auth
msgid "Manage API authentication keys."
msgstr "Gestiona las claves de autenticación de la API."

#: sergio auth create-key
msgid "Generate a new API key and store it in config."
msgstr "Genera una clave de API nueva y la guarda en la configuración."

#: sergio auth revoke-key
msgid "Revoke the current API key."
msgstr "Revoca la clave de API actual."

#: sergio bench
msgid "Run inference benchmarks."
msgstr "Ejecuta pruebas de rendimiento de inferencia."

#: sergio bench run
msgid "Run benchmarks against an inference engine."
msgstr "Ejecuta pruebas de rendimiento contra un motor de inferencia."

#: sergio bench run -m
msgid "Model to benchmark."
msgstr "Modelo a evaluar."

#: sergio bench run -n
msgid "Number of samples per benchmark."
msgstr "Número de muestras por prueba."

#: sergio bench run -b
msgid "Specific benchmark to run (default: all)."
msgstr "Prueba concreta a ejecutar (por defecto: todas)."

#: sergio bench run -o
msgid "Write JSONL results to file."
msgstr "Escribe los resultados JSONL en un archivo."

#: sergio bench run --json
msgid "Output JSON summary to stdout."
msgstr "Muestra un resumen JSON por la salida estándar."

#: sergio bench run -w
msgid "Number of warmup iterations before measurement."
msgstr "Iteraciones de calentamiento antes de medir."

#: sergio bench run --setup-energy
msgid "Run energy monitor setup script when missing (for energy benchmark)."
msgstr "Ejecuta la instalación del monitor de energía si falta (para la prueba de energía)."

#: sergio bench skills
msgid "Run the PinchBench skills benchmark across one or all conditions."
msgstr "Ejecuta la prueba de habilidades PinchBench en una o todas las condiciones."

#: sergio bench skills --condition
msgid "Which condition(s) to run."
msgstr "Qué condición(es) ejecutar."

#: sergio bench skills --seeds
msgid "Random seeds to run per condition."
msgstr "Semillas aleatorias por condición."

#: sergio bench skills --max-samples
msgid "Limit number of PinchBench tasks (default: full benchmark)."
msgstr "Limita el número de tareas de PinchBench (por defecto: la prueba completa)."

#: sergio bench skills --model
msgid "Model identifier."
msgstr "Identificador del modelo."

#: sergio bench skills --output-dir
msgid "Where the markdown report lands."
msgstr "Dónde se guarda el informe en Markdown."

#: sergio channel
msgid "Manage messaging channels."
msgstr "Gestiona los canales de mensajería."

#: sergio channel list
msgid "List available channels."
msgstr "Lista los canales disponibles."

#: sergio channel list --channel-type
msgid "Channel type (sendblue, telegram, discord, slack, webhook, email, whatsapp, whatsapp_baileys, signal, google_chat, irc, webchat, teams, matrix, mattermost, feishu, bluebubbles)."
msgstr "Tipo de canal (sendblue, telegram, discord, slack, webhook, email, whatsapp, whatsapp_baileys, signal, google_chat, irc, webchat, teams, matrix, mattermost, feishu, bluebubbles)."

#: sergio channel send
msgid "Send a message to a channel."
msgstr "Envía un mensaje a un canal."

#: sergio channel status
msgid "Show channel connection status."
msgstr "Muestra el estado de conexión de los canales."

#: sergio channels
msgid "Manage messaging channels (iMessage/SMS via SendBlue, Slack)."
msgstr "Gestiona canales de mensajería (iMessage/SMS con SendBlue, Slack)."

#: sergio channels imessage-start
msgid "Start the iMessage daemon for CHAT_IDENTIFIER.\n\n    CHAT_IDENTIFIER is the phone number or email to monitor."
msgstr "Inicia el servicio de iMessage para CHAT_IDENTIFIER.\n\n    CHAT_IDENTIFIER es el número de teléfono o el correo a vigilar."

#: sergio channels imessage-start --background
msgid "Run in background."
msgstr "Ejecuta en segundo plano."

#: sergio channels imessage-stop
msgid "Stop the iMessage daemon."
msgstr "Detiene el servicio de iMessage."

#: sergio channels status
msgid "Show status of all configured channels."
msgstr "Muestra el estado de todos los canales configurados."

#: sergio chat
msgid "Start an interactive multi-turn chat session.\n\n    Model: omit ``-m`` to use ``[intelligence] model_chat`` if set, else\n    ``default_model``; ``-m smart`` is the same. Use ``--pick-model`` to open the\n    engine list first (bare ``jarvis`` does this on a TTY unless\n    ``JARVIS_SKIP_MODEL_PICK=1``).\n\n    Commands during chat:\n      /quit, /exit  — end session\n      /clear        — clear conversation history\n      /model        — show current model\n      /runtime      — Ollama context + GPU offload for this session\n      /help         — show available commands\n      /history      — show conversation history\n\n    Pass --voice to use microphone input (silence-detection) and hear responses\n    read back via text-to-speech (kokoro local or OpenAI TTS)."
msgstr "Inicia una conversación interactiva de varios turnos.\n\n    Modelo: sin ``-m`` usa ``[intelligence] model_chat`` si existe, si no\n    ``default_model``; ``-m smart`` es lo mismo. Usa ``--pick-model`` para abrir\n    primero la lista de motores (``jarvis`` a secas lo hace en una terminal salvo\n    con ``JARVIS_SKIP_MODEL_PICK=1``).\n\n    Comandos durante la conversación:\n      /quit, /exit  — termina la sesión\n      /clear        — borra el historial\n      /model        — muestra el modelo actual\n      /runtime      — contexto de Ollama y GPU para esta sesión\n      /help         — muestra los comandos disponibles\n      /history      — muestra el historial\n\n    Usa --voice para hablar por el micrófono (con detección de silencio) y oír\n    las respuestas en voz (kokoro local o TTS de OpenAI)."

#: sergio chat -m
msgid "Model id. Omit or use ``smart`` for preset: [intelligence] model_chat / model_short / model_long / model_code, then default_model."
msgstr "Id del modelo. Omítelo o usa ``smart`` para el ajuste: [intelligence] model_chat / model_short / model_long / model_code, luego default_model."

#: sergio chat --pick-model
msgid "Show the model list before chat. Bare ``jarvis`` already does this on a TTY unless JARVIS_SKIP_MODEL_PICK=1."
msgstr "Muestra la lista de modelos antes de conversar. ``jarvis`` a secas ya lo hace en una terminal salvo con JARVIS_SKIP_MODEL_PICK=1."

#: sergio chat -a
msgid "Agent type."
msgstr "Tipo de agente."

#: sergio chat --tools
msgid "Comma-separated tool names."
msgstr "Herramientas, separadas por comas."

#: sergio chat --system
msgid "Custom system prompt."
msgstr "Instrucciones de sistema personalizadas."

#: sergio chat --voice
msgid "Enable voice I/O: mic input with silence detection + TTS response playback."
msgstr "Activa la voz: micrófono con detección de silencio y respuestas habladas."

#: sergio chat --skip-runtime-panel
msgid "Do not prompt for context/GPU after model pick."
msgstr "No pregunta por contexto/GPU después de elegir modelo."

#: sergio chat --num-gpu
msgid "Ollama GPU layers (-1=all, 0=CPU). Skips runtime panel when set."
msgstr "Capas de GPU de Ollama (-1=todas, 0=CPU). Con este valor se salta el panel de ejecución."

#: sergio chat --num-ctx
msgid "Context window (tokens, max 200k). Skips runtime panel when set."
msgstr "Ventana de contexto (tokens, máximo 200k). Con este valor se salta el panel de ejecución."

#: sergio compose
msgid "Compose, run, benchmark, and deploy OpenJarvis configurations.\n\n    Recipes are unified TOML configs that wire all five primitives\n    (Intelligence, Engine, Agent, Tools, Learning).  They come in two\n    kinds:\n\n    \b\n      discrete   One-shot or benchmark-oriented agents\n      operator   Persistent, scheduled autonomous agents"
msgstr "Compone, ejecuta, evalúa y despliega configuraciones de Sergio.\n\n    Las recetas son configuraciones TOML que conectan las cinco piezas\n    (Inteligencia, Motor, Agente, Herramientas, Aprendizaje). Hay dos\n    tipos:\n\n    \b\n      discrete   Agentes de una sola vez o para pruebas\n      operator   Agentes autónomos persistentes y programados"

#: sergio compose bench
msgid "Benchmark a discrete composition against eval datasets.\n\n    Uses the recipe's model, engine, agent, and tools to run the eval\n    framework against the benchmarks defined in the recipe (or overridden\n    via --benchmark)."
msgstr "Evalúa una composición discreta con conjuntos de datos de evaluación.\n\n    Usa el modelo, motor, agente y herramientas de la receta para pasar el\n    marco de evaluación por las pruebas definidas en la receta (o las\n    indicadas con --benchmark)."

#: sergio compose bench -b
msgid "Override benchmarks (can specify multiple)."
msgstr "Cambia las pruebas (se pueden indicar varias)."

#: sergio compose bench -n
msgid "Maximum samples per benchmark."
msgstr "Máximo de muestras por prueba."

#: sergio compose bench --judge
msgid "LLM judge model override."
msgstr "Modelo juez (LLM) a usar en su lugar."

#: sergio compose bench -v
msgid "Verbose logging."
msgstr "Registro detallado."

#: sergio compose deploy
msgid "Deploy an operator composition (activate its scheduler task)."
msgstr "Despliega una composición de tipo operador (activa su tarea programada)."

#: sergio compose list
msgid "List all discovered compositions (recipes and operators)."
msgstr "Lista todas las composiciones encontradas (recetas y operadores)."

#: sergio compose list -k
msgid "Filter by recipe kind."
msgstr "Filtra por tipo de receta."

#: sergio compose run
msgid "Run a composition against a single query."
msgstr "Ejecuta una composición con una sola pregunta."

#: sergio compose show
msgid "Show detailed configuration of a composition."
msgstr "Muestra la configuración detallada de una composición."

#: sergio compose status
msgid "Show status of all deployed operators."
msgstr "Muestra el estado de todos los operadores desplegados."

#: sergio compose stop
msgid "Stop a deployed operator composition."
msgstr "Detiene una composición de operador desplegada."

#: sergio config
msgid "Inspect configuration — show loaded settings, hardware, and config files."
msgstr "Inspecciona la configuración: ajustes cargados, hardware y archivos de configuración."

#: sergio config path
msgid "Print the resolved OpenJarvis directories (home, config, cache).\n\n    All OpenJarvis state lives under a single root, resolved in priority\n    order: ``$OPENJARVIS_HOME`` > ``$XDG_DATA_HOME/openjarvis`` >\n    ``~/.openjarvis``. Use this to confirm where your data is stored after\n    setting an override."
msgstr "Muestra las carpetas de Sergio (inicio, configuración, caché).\n\n    Todo el estado de Sergio vive bajo una sola raíz, elegida en este\n    orden: ``$OPENJARVIS_HOME`` > ``$XDG_DATA_HOME/openjarvis`` >\n    ``~/.openjarvis``. Úsalo para confirmar dónde se guardan tus datos después\n    de cambiarla."

#: sergio config set
msgid "Set a configuration value (e.g. jarvis config set engine.ollama.host URL)."
msgstr "Cambia un valor de la configuración (p. ej. jarvis config set engine.ollama.host URL)."

#: sergio config show
msgid "Show configuration details."
msgstr "Muestra los detalles de la configuración."

#: sergio config show --path
msgid "Explicit config file path"
msgstr "Ruta explícita del archivo de configuración"

#: sergio config show --json
msgid "Output as JSON"
msgstr "Salida en JSON"

#: sergio config show hardware
msgid "Show detected hardware information with recommended engine and model."
msgstr "Muestra el hardware detectado con el motor y el modelo recomendados."

#: sergio config show json
msgid "Show the parsed TOML configuration as JSON."
msgstr "Muestra la configuración TOML interpretada, en JSON."

#: sergio config show loaded
msgid "Show the loaded effective configuration from config.toml."
msgstr "Muestra la configuración efectiva cargada desde config.toml."

#: sergio config show toml
msgid "Show the raw TOML configuration file content with syntax highlighting."
msgstr "Muestra el archivo de configuración TOML tal cual, con colores."

#: sergio connect
msgid "Manage data source connections (Gmail, Obsidian, etc.)."
msgstr "Gestiona las conexiones a fuentes de datos (Gmail, Obsidian, etc.)."

#: sergio connect --list
msgid "List connected sources and sync status."
msgstr "Lista las fuentes conectadas y su sincronización."

#: sergio connect --sync
msgid "Trigger incremental sync for all sources."
msgstr "Sincroniza lo nuevo de todas las fuentes."

#: sergio connect --disconnect
msgid "Disconnect a source."
msgstr "Desconecta una fuente."

#: sergio connect --path
msgid "Path for filesystem connectors (e.g., Obsidian vault)."
msgstr "Ruta para conectores de archivos (p. ej. una bóveda de Obsidian)."

#: sergio deep-research-setup
msgid "Auto-detect local data sources, ingest, and launch Deep Research chat."
msgstr "Detecta tus fuentes de datos locales, las incorpora y abre el chat de investigación profunda."

#: sergio deep-research-setup --obsidian-vault
msgid "Path to an Obsidian vault directory."
msgstr "Ruta a una carpeta de bóveda de Obsidian."

#: sergio deep-research-setup --skip-chat
msgid "Ingest only, don't launch chat."
msgstr "Solo incorporar, sin abrir el chat."

#: sergio digest
msgid "Display and play the morning digest."
msgstr "Muestra y reproduce el resumen de la mañana."

#: sergio digest --text-only
msgid "Print text without audio playback."
msgstr "Muestra el texto sin reproducir audio."

#: sergio digest --fresh
msgid "Re-generate the digest (skip cache)."
msgstr "Vuelve a generar el resumen (sin usar la caché)."

#: sergio digest --history
msgid "Show past digests."
msgstr "Muestra resúmenes anteriores."

#: sergio digest --section
msgid "Show only a specific section."
msgstr "Muestra solo una sección."

#: sergio digest --db-path
msgid "Path to digest database."
msgstr "Ruta a la base de datos de resúmenes."

#: sergio digest --schedule
msgid "Set cron schedule (e.g. \"0 6 * * *\"), \"off\" to disable, or empty to show status."
msgstr "Programa con cron (p. ej. \"0 6 * * *\"), \"off\" para desactivar, o vacío para ver el estado."

#: sergio doctor
msgid "Run diagnostic checks on your Sergio installation."
msgstr "Revisa tu instalación de Sergio y detecta problemas."

#: sergio doctor --json
msgid "Output results as JSON."
msgstr "Resultados en JSON."

#: sergio ecc
msgid "ECC (Everything Claude Code): expert playbooks Sergio reads on demand."
msgstr "ECC (Everything Claude Code): guías expertas que Sergio lee cuando las necesita."

#: sergio ecc actualizar
msgid "Download ECC the first time, or update it."
msgstr "Descarga ECC la primera vez, o lo actualiza."

#: sergio ecc buscar
msgid "Search the guides (English keywords work best)."
msgstr "Busca en las guías (funcionan mejor las palabras en inglés)."

#: sergio ecc estado
msgid "Show whether ECC is installed and how many guides it has."
msgstr "Muestra si ECC está instalado y cuántas guías tiene."

#: sergio escritorio
msgid "Sergio in Windows: cursor companion, voice, and control of the screen."
msgstr "Sergio en Windows: compañero del cursor, voz y control de la pantalla."

#: sergio escritorio estado
msgid "Check that Sergio can reach Sergio Escritorio."
msgstr "Comprueba que Sergio llega a Sergio Escritorio."

#: sergio escritorio instalar
msgid "Install (or update) Sergio Escritorio in Windows."
msgstr "Instala (o actualiza) Sergio Escritorio en Windows."

#: sergio escritorio instalar --vision
msgid "Also download a local vision model (qwen2.5vl:7b, ~6 GB) so Sergio can describe images on screen."
msgstr "Descarga también un modelo de visión local (qwen2.5vl:7b, ~6 GB) para que Sergio describa lo que hay en pantalla."

#: sergio escritorio instalar --gpu
msgid "Also download the NVIDIA libraries (~1 GB) so Sergio hears with the big Whisper model on the graphics card."
msgstr "Descarga también las librerías de NVIDIA (~1 GB) para que Sergio oiga con el modelo grande de Whisper en la tarjeta gráfica."

#: sergio eval
msgid "Evaluation framework — benchmark models, agents, and learning."
msgstr "Marco de evaluación: compara modelos, agentes y aprendizaje."

#: sergio eval compare
msgid "Compare results from multiple eval runs."
msgstr "Compara resultados de varias evaluaciones."

#: sergio eval compare --metric
msgid "Metric to compare across runs (default: accuracy)."
msgstr "Métrica a comparar entre ejecuciones (por defecto: accuracy)."

#: sergio eval list
msgid "List available benchmarks and backends."
msgstr "Lista las pruebas y motores disponibles."

#: sergio eval report
msgid "Generate detailed report from eval results."
msgstr "Genera un informe detallado de los resultados."

#: sergio eval run
msgid "Run evaluation benchmarks."
msgstr "Ejecuta pruebas de evaluación."

#: sergio eval run -c
msgid "TOML config file for suite runs."
msgstr "Archivo de configuración TOML para baterías de pruebas."

#: sergio eval run -b
msgid "Benchmark to run (e.g. supergpqa, gaia, frames, wildchat)."
msgstr "Prueba a ejecutar (p. ej. supergpqa, gaia, frames, wildchat)."

#: sergio eval run -n
msgid "Maximum samples to evaluate."
msgstr "Máximo de muestras a evaluar."

#: sergio eval run --backend
msgid "Inference backend. For hermes/openclaw, also pass --base-url and --api-key (or set JARVIS_BACKEND_BASE_URL/JARVIS_BACKEND_API_KEY)."
msgstr "Motor de inferencia. Para hermes/openclaw pasa también --base-url y --api-key (o define JARVIS_BACKEND_BASE_URL/JARVIS_BACKEND_API_KEY)."

#: sergio eval run --base-url
msgid "OpenAI-compatible endpoint for the model under eval. Required for hermes/openclaw; for jarvis-direct/jarvis-agent/terminalbench-native it bypasses engine discovery and targets this URL directly (env: JARVIS_BACKEND_BASE_URL)."
msgstr "Endpoint compatible con OpenAI del modelo evaluado. Obligatorio para hermes/openclaw; en jarvis-direct/jarvis-agent/terminalbench-native evita la detección de motores y usa esta URL directamente (entorno: JARVIS_BACKEND_BASE_URL)."

#: sergio eval run --api-key
msgid "API key for the --base-url endpoint, sent as a Bearer token. Required for hermes/openclaw; optional for first-party backends (env: JARVIS_BACKEND_API_KEY)."
msgstr "Clave de API para el endpoint de --base-url, enviada como token Bearer. Obligatoria para hermes/openclaw; opcional para los motores propios (entorno: JARVIS_BACKEND_API_KEY)."

#: sergio eval run --agent
msgid "Agent name for jarvis-agent backend."
msgstr "Nombre del agente para el motor jarvis-agent."

#: sergio eval run -e
msgid "Engine key (ollama, vllm, cloud, ...)."
msgstr "Clave del motor (ollama, vllm, cloud, ...)."

#: sergio eval run --telemetry
msgid "Enable telemetry collection during eval."
msgstr "Recoge telemetría durante la evaluación."

#: sergio eval run --gpu-metrics
msgid "Enable GPU metrics collection."
msgstr "Recoge métricas de la GPU."

#: sergio eval run --seed
msgid "Random seed."
msgstr "Semilla aleatoria."

#: sergio eval run --temperature
msgid "Generation temperature."
msgstr "Temperatura de generación."

#: sergio eval run --max-tokens
msgid "Max output tokens."
msgstr "Máximo de tokens de salida."

#: sergio eval run --model-filter
msgid "Filter models by name substring (for multi-model configs)."
msgstr "Filtra modelos por parte del nombre (configuraciones con varios modelos)."

#: sergio eval run -o
msgid "Output JSONL path."
msgstr "Ruta del archivo JSONL de salida."

#: sergio eval run --wandb-project
msgid "W&B project name (enables W&B tracking)."
msgstr "Nombre del proyecto de W&B (activa el seguimiento en W&B)."

#: sergio eval run --wandb-entity
msgid "W&B entity (team or user)."
msgstr "Entidad de W&B (equipo o usuario)."

#: sergio eval run --wandb-tags
msgid "Comma-separated W&B tags."
msgstr "Etiquetas de W&B separadas por comas."

#: sergio eval run --wandb-group
msgid "W&B run group."
msgstr "Grupo de ejecuciones de W&B."

#: sergio eval run --sheets-id
msgid "Google Sheets spreadsheet ID."
msgstr "ID de la hoja de cálculo de Google Sheets."

#: sergio eval run --sheets-worksheet
msgid "Google Sheets worksheet name."
msgstr "Nombre de la pestaña de Google Sheets."

#: sergio eval run --sheets-creds
msgid "Path to Google service account JSON."
msgstr "Ruta al JSON de la cuenta de servicio de Google."

#: sergio evolve
msgid "Adapt to the user: consolidate learned facts into USER.md."
msgstr "Se adapta a ti: reúne lo aprendido en USER.md."

#: sergio evolve --force
msgid "Run even if nothing new was learned."
msgstr "Ejecuta aunque no haya aprendido nada nuevo."

#: sergio evolve --show
msgid "Print the resulting profile."
msgstr "Muestra el perfil resultante."

#: sergio extensions
msgid "Bundled extensions: OpenClacky (computer agent) and the 3D globe."
msgstr "Extensiones incluidas: el agente de código y el globo 3D."

#: sergio extensions logs
msgid "Print the last lines of an extension's log."
msgstr "Muestra las últimas líneas del registro de una extensión."

#: sergio extensions run
msgid "Run in the foreground for a service manager (systemd).\n\n    Starts the extensions, restarts them if they crash, and stops them on\n    SIGTERM/Ctrl-C."
msgstr "Ejecuta en primer plano para un gestor de servicios (systemd).\n\n    Inicia las extensiones, las reinicia si se caen y las detiene con\n    SIGTERM/Ctrl-C."

#: sergio extensions run --interval
msgid "Health check, s."
msgstr "Comprobación de salud, en segundos."

#: sergio extensions start
msgid "Start one extension or all of them in the background."
msgstr "Inicia una extensión o todas en segundo plano."

#: sergio extensions status
msgid "Show whether each extension is available and running."
msgstr "Muestra si cada extensión está disponible y en marcha."

#: sergio extensions stop
msgid "Stop one extension or all of them."
msgstr "Detiene una extensión o todas."

#: sergio feedback
msgid "Trace feedback management."
msgstr "Gestión de valoraciones de trazas."

#: sergio feedback evaluate
msgid "Run LLM judge on recent traces."
msgstr "Pasa el juez (LLM) por las trazas recientes."

#: sergio feedback evaluate --since
msgid "Evaluate traces since (e.g. 7d, 24h)."
msgstr "Evalúa trazas desde hace (p. ej. 7d, 24h)."

#: sergio feedback score
msgid "Record explicit feedback for a trace."
msgstr "Registra una valoración explícita para una traza."

#: sergio feedback score -s
msgid "Feedback score (0.0-1.0)."
msgstr "Puntuación (0.0-1.0)."

#: sergio feedback stats
msgid "Show feedback statistics."
msgstr "Muestra estadísticas de las valoraciones."

#: sergio feedback thumbs
msgid "Rate a trace with thumbs up/down."
msgstr "Valora una traza con pulgar arriba/abajo."

#: sergio feedback thumbs --last
msgid "Rate the last interaction."
msgstr "Valora la última interacción."

#: sergio feedback thumbs --up
msgid "Thumbs up or down."
msgstr "Pulgar arriba o abajo."

#: sergio gateway
msgid "Manage the Sergio multi-channel gateway."
msgstr "Gestiona la pasarela multicanal de Sergio."

#: sergio gateway logs
msgid "View gateway logs."
msgstr "Muestra los registros de la pasarela."

#: sergio gateway start
msgid "Start the gateway daemon."
msgstr "Inicia el servicio de la pasarela."

#: sergio gateway start --install
msgid "Generate and enable systemd/launchd service"
msgstr "Genera y activa el servicio de systemd/launchd"

#: sergio gateway status
msgid "Check gateway status."
msgstr "Comprueba el estado de la pasarela."

#: sergio gateway stop
msgid "Stop the gateway daemon."
msgstr "Detiene el servicio de la pasarela."

#: sergio gui
msgid "Start the browser-based graphical mode in the default browser.\n\n    This command is intended for source checkouts. For an installed desktop\n    application, launch Sergio from the operating system menu instead."
msgstr "Abre el modo gráfico en el navegador predeterminado.\n\n    Este comando es para copias del código fuente. Si instalaste la aplicación\n    de escritorio, ábrela desde el menú del sistema operativo."

#: sergio gui --no-server
msgid "Do not start the API server."
msgstr "No inicia el servidor de la API."

#: sergio gui --no-extensions
msgid "Do not start the bundled coding agent and 3D globe."
msgstr "No inicia el agente de código ni el globo 3D incluidos."

#: sergio gui --no-browser
msgid "Only start the frontend."
msgstr "Solo inicia la interfaz."

#: sergio host
msgid "Download (if needed) and serve a model locally.\n\n    Examples:\n\n    \b\n      jarvis host mlx-community/Qwen2.5-7B-4bit --backend mlx\n      jarvis host Qwen/Qwen3-8B --backend vllm\n      jarvis host qwen3:8b --backend ollama\n      jarvis host meta-llama/Llama-3-8B -b sglang"
msgstr "Descarga (si hace falta) y sirve un modelo en local.\n\n    Ejemplos:\n\n    \b\n      jarvis host mlx-community/Qwen2.5-7B-4bit --backend mlx\n      jarvis host Qwen/Qwen3-8B --backend vllm\n      jarvis host qwen3:8b --backend ollama\n      jarvis host meta-llama/Llama-3-8B -b sglang"

#: sergio host -b
msgid "Inference backend to use. Auto-detected if omitted."
msgstr "Motor de inferencia a usar. Se detecta solo si se omite."

#: sergio host -p
msgid "Port to serve on (default depends on backend)."
msgstr "Puerto donde servir (por defecto depende del motor)."

#: sergio host --trust-remote-code
msgid "Pass --trust-remote-code to the backend."
msgstr "Pasa --trust-remote-code al motor."

#: sergio init
msgid "Detect hardware and generate ~/.openjarvis/config.toml."
msgstr "Detecta el hardware y genera ~/.openjarvis/config.toml."

#: sergio init --force
msgid "Overwrite existing config without prompting."
msgstr "Sobrescribe la configuración existente sin preguntar."

#: sergio init --config
msgid "Path to config file to use."
msgstr "Ruta del archivo de configuración a usar."

#: sergio init --full
msgid "Generate full reference config with all sections"
msgstr "Genera la configuración de referencia completa, con todas las secciones"

#: sergio init --engine
msgid "Inference engine to use (skips interactive selection)."
msgstr "Motor de inferencia a usar (se salta la selección interactiva)."

#: sergio init --no-download
msgid "Skip the model download prompt."
msgstr "No pregunta por la descarga del modelo."

#: sergio init --no-scan
msgid "Skip the post-init security environment audit."
msgstr "Se salta la auditoría de seguridad del entorno tras la inicialización."

#: sergio init --host
msgid "Remote engine host URL (e.g. http://192.168.1.50:11434)."
msgstr "URL del motor remoto (p. ej. http://192.168.1.50:11434)."

#: sergio init --digest
msgid "Include Morning Digest config section."
msgstr "Incluye la sección de configuración del resumen de la mañana."

#: sergio init --preset
msgid "Use a pre-built starter config instead of generating one."
msgstr "Usa una configuración inicial ya hecha en lugar de generarla."

#: sergio init --from-bare-jarvis
msgid "Run init non-interactively; called by the bare-jarvis first-run guard."
msgstr "Inicializa sin preguntas; lo usa la protección del primer arranque de jarvis."

#: sergio memory
msgid "Manage the memory store."
msgstr "Gestiona el almacén de memoria."

#: sergio memory clear
msgid "Remove all durable facts captured by the automatic memory service."
msgstr "Borra todos los datos duraderos guardados por la memoria automática."

#: sergio memory clear --yes
msgid "Skip the confirmation prompt."
msgstr "No pide confirmación."

#: sergio memory index
msgid "Index documents from a file or directory."
msgstr "Indexa documentos de un archivo o una carpeta."

#: sergio memory index --backend
msgid "Override the default memory backend."
msgstr "Usa otro tipo de memoria en lugar del predeterminado."

#: sergio memory index --chunk-size
msgid "Chunk size in tokens."
msgstr "Tamaño de cada trozo, en tokens."

#: sergio memory index --chunk-overlap
msgid "Overlap between chunks in tokens."
msgstr "Solapamiento entre trozos, en tokens."

#: sergio memory list
msgid "List durable facts captured by the automatic memory service."
msgstr "Lista los datos duraderos guardados por la memoria automática."

#: sergio memory search
msgid "Search the memory store."
msgstr "Busca en el almacén de memoria."

#: sergio memory search --top-k
msgid "Number of results to return."
msgstr "Número de resultados."

#: sergio memory stats
msgid "Show memory store statistics."
msgstr "Muestra estadísticas del almacén de memoria."

#: sergio memory trust
msgid "Promote quarantined fact INDEX (as shown by `memory list`) to trusted.\n\n    Only do this after reading the fact: a quarantined fact matched an\n    injection pattern, and promoting it puts its text into future prompts."
msgstr "Pasa a confiable el dato en cuarentena INDEX (como lo muestra `memory list`).\n\n    Hazlo solo después de leer el dato: un dato en cuarentena coincidió con un\n    patrón de inyección, y al confiar en él su texto entra en futuros prompts."

#: sergio mine
msgid "Configure and run Pearl mining."
msgstr "Configura y ejecuta la minería de Pearl."

#: sergio mine attach
msgid "Manual mode: write a sidecar for an externally-started miner."
msgstr "Modo manual: escribe un archivo auxiliar para un minero iniciado por fuera."

#: sergio mine doctor
msgid "Diagnose mining capability with one row per check."
msgstr "Diagnostica la capacidad de minar, una fila por comprobación."

