msgstr "La voz de Sergio con ElevenLabs (grave, cálida, rasposa; el menor retraso)."

#: sergio nube voz --elevenlabs
msgid "ElevenLabs API key."
msgstr "Clave de API de ElevenLabs."

#: sergio operators
msgid "Manage operators — persistent, scheduled autonomous agents."
msgstr "Gestiona operadores: agentes autónomos persistentes y programados."

#: sergio operators activate
msgid "Activate an operator (creates a scheduler task)."
msgstr "Activa un operador (crea una tarea programada)."

#: sergio operators deactivate
msgid "Deactivate an operator (cancels its scheduler task)."
msgstr "Desactiva un operador (cancela su tarea programada)."

#: sergio operators info
