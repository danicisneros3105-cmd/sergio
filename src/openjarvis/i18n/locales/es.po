msgid "Pearl model id to inspect."
msgstr "Id del modelo Pearl a inspeccionar."

#: sergio mine inspect-model --allow-planned
msgid "Inspect planned models even though they are not enabled for mining yet."
msgstr "Inspecciona modelos planeados aunque aún no estén habilitados para minar."

#: sergio mine inspect-model --hf-token-env
msgid "Environment variable containing a Hugging Face token."
msgstr "Variable de entorno con un token de Hugging Face."

#: sergio mine inspect-model --output
msgid "Write a JSON artifact inspection report."
msgstr "Escribe un informe JSON de la inspección."

#: sergio mine logs
msgid "Print the Pearl miner container log tail."
msgstr "Muestra el final del registro del contenedor minero de Pearl."

#: sergio mine models
msgid "List Pearl model support status."
msgstr "Lista qué modelos Pearl están soportados."

#: sergio mine start
msgid "Launch the configured mining provider."
msgstr "Inicia el proveedor de minería configurado."

#: sergio mine status
msgid "Print live mining stats."
msgstr "Muestra estadísticas de minería en directo."

#: sergio mine stop
msgid "Stop the configured mining provider."
msgstr "Detiene el proveedor de minería configurado."

#: sergio mine validate-model
msgid "Collect runtime evidence for Pearl model validation."
msgstr "Reúne pruebas en ejecución para validar un modelo Pearl."

#: sergio mine validate-model --model
msgid "Pearl model id to validate."
msgstr "Id del modelo Pearl a validar."

#: sergio mine validate-model --vllm-endpoint
msgid "OpenAI-compatible vLLM endpoint, defaults to the mining sidecar."
msgstr "Endpoint vLLM compatible con OpenAI; por defecto el auxiliar de minería."

#: sergio mine validate-model --gateway-metrics-url
msgid "Pearl gateway metrics URL, defaults to the mining sidecar."
msgstr "URL de métricas de la pasarela Pearl; por defecto el auxiliar de minería."

#: sergio mine validate-model --allow-planned
msgid "Allow planned models while collecting validation evidence."
msgstr "Permite modelos planeados mientras se reúnen pruebas."

#: sergio mine validate-model --prompt
msgid "Optional chat-completion smoke prompt to run through vLLM."
msgstr "Prompt de prueba opcional para pasar por vLLM."

#: sergio mine validate-model --output
msgid "Write a JSON validation artifact."
msgstr "Escribe un informe JSON de la validación."

#: sergio model
msgid "Manage language models."
msgstr "Gestiona los modelos de lenguaje."

#: sergio model convert
