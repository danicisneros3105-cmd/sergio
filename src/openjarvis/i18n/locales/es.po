msgstr "Ejecuta un ciclo de optimización sobre la configuración de Sergio."

#: sergio optimize run -c
msgid "TOML config file for the optimization run."
msgstr "Archivo de configuración TOML para la optimización."

#: sergio optimize run -b
msgid "Benchmark name (e.g. supergpqa, mmlu-pro)."
msgstr "Nombre de la prueba (p. ej. supergpqa, mmlu-pro)."

#: sergio optimize run -t
msgid "Maximum number of trials."
msgstr "Máximo de intentos."

#: sergio optimize run --optimizer-model
msgid "Model used by the LLM optimizer."
msgstr "Modelo que usa el optimizador."

#: sergio optimize run --max-samples
msgid "Maximum samples per trial evaluation."
msgstr "Máximo de muestras por evaluación de cada intento."

#: sergio optimize run --output-dir
