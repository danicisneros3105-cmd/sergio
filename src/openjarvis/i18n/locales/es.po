msgstr "Revisa tu entorno en busca de riesgos de privacidad y seguridad."

#: sergio scan --quick
msgid "Run only critical checks."
msgstr "Ejecuta solo las comprobaciones críticas."

#: sergio scan --json
msgid "Output as JSON."
msgstr "Salida en JSON."

#: sergio scan --data-boundaries
msgid "Run application data-boundary checks instead of host checks."
msgstr "Revisa los límites de datos de la aplicación en lugar del equipo."

#: sergio scan --strict
msgid "Exit non-zero if data-boundary fail or warn findings are present."
msgstr "Termina con error si hay fallos o avisos en los límites de datos."

#: sergio scan --show-paths
msgid "Show absolute paths in data-boundary output."
msgstr "Muestra rutas absolutas en la revisión de límites de datos."

#: sergio scheduler
msgid "Manage scheduled tasks."
msgstr "Gestiona las tareas programadas."

#: sergio scheduler cancel
msgid "Cancel a scheduled task."
msgstr "Cancela una tarea programada."

#: sergio scheduler create
msgid "Create a new scheduled task."
msgstr "Crea una tarea programada nueva."

#: sergio scheduler create --type
msgid "Schedule type."
msgstr "Tipo de programación."

#: sergio scheduler create --value
msgid "Schedule value (cron expr, seconds, or ISO datetime)."
msgstr "Valor de la programación (expresión cron, segundos o fecha ISO)."

#: sergio scheduler create --agent
msgid "Agent to use for execution."
msgstr "Agente que la ejecuta."

#: sergio scheduler list
msgid "List scheduled tasks."
msgstr "Lista las tareas programadas."

#: sergio scheduler list --status
msgid "Filter by status."
msgstr "Filtra por estado."

#: sergio scheduler logs
msgid "Show run logs for a scheduled task."
msgstr "Muestra los registros de ejecución de una tarea programada."

#: sergio scheduler logs -n
msgid "Number of logs to show."
msgstr "Cuántos registros mostrar."

#: sergio scheduler pause
msgid "Pause a scheduled task."
msgstr "Pausa una tarea programada."

#: sergio scheduler resume
msgid "Resume a paused task."
msgstr "Reanuda una tarea pausada."

#: sergio scheduler run-task
msgid "Immediately execute the active task for AGENT_NAME.\n\n    Finds the first active scheduled task whose agent matches AGENT_NAME\n    and runs it right now — useful for testing and for launchd invocation\n    when OpenJarvis is not running as a persistent daemon.\n\n    Example (launchd plist ProgramArguments):\n        jarvis scheduler run-task proactive"
msgstr "Ejecuta ya la tarea activa de AGENT_NAME.\n\n    Busca la primera tarea programada activa cuyo agente sea AGENT_NAME\n    y la ejecuta en este momento; útil para pruebas y para launchd\n    cuando Sergio no corre como servicio permanente.\n\n    Ejemplo (ProgramArguments de un plist de launchd):\n        jarvis scheduler run-task proactive"

#: sergio scheduler run-task --dry-run
msgid "Print what would run without executing."
msgstr "Muestra qué se ejecutaría, sin ejecutarlo."

#: sergio scheduler start
msgid "Start the scheduler daemon (foreground)."
msgstr "Inicia el servicio planificador (en primer plano)."

#: sergio scheduler start --poll-interval
msgid "Seconds between poll cycles."
msgstr "Segundos entre cada revisión."

#: sergio self-update
msgid "Upgrade Sergio to the latest release. Detects how you installed (pip, uv tool, editable git) and runs the right command. Use --check to only print the upgrade command without running it."
msgstr "Actualiza Sergio a la última versión. Detecta cómo lo instalaste (pip, uv tool, git editable) y ejecuta el comando correcto. Usa --check para ver el comando sin ejecutarlo."

#: sergio self-update --check
msgid "Print the upgrade command that would run, without executing it."
msgstr "Muestra el comando de actualización sin ejecutarlo."

#: sergio self-update --yes
msgid "Skip the interactive confirmation prompt."
msgstr "No pide confirmación."

#: sergio serve
msgid "Start the OpenAI-compatible API server."
msgstr "Inicia el servidor de API compatible con OpenAI."

#: sergio serve --host
msgid "Bind address (default: config)."
msgstr "Dirección de escucha (por defecto: la de la configuración)."

#: sergio serve --port
msgid "Port number (default: config)."
msgstr "Puerto (por defecto: el de la configuración)."

#: sergio serve -m
msgid "Default model."
msgstr "Modelo predeterminado."

#: sergio serve -a
msgid "Agent for chat requests (simple, orchestrator, react, openhands)."
msgstr "Agente para las peticiones de chat (simple, orchestrator, react, openhands)."

#: sergio servicio
msgid "Run Sergio permanently in the background (systemd user services)."
msgstr "Sergio siempre en segundo plano (servicios de usuario de systemd)."

#: sergio servicio apagar
msgid "Switch Sergio off (it stays off after reboots until `encender`)."
msgstr "Apaga a Sergio (sigue apagado tras reiniciar hasta `encender`)."

#: sergio servicio desinstalar
msgid "Stop the services and remove them."
msgstr "Detiene los servicios y los quita."

#: sergio servicio encender
msgid "Switch Sergio on (and keep it on after reboots)."
msgstr "Enciende a Sergio (y lo mantiene encendido tras reiniciar)."

#: sergio servicio estado
msgid "Show whether the services are running."
msgstr "Muestra si los servicios están en marcha."

#: sergio servicio instalar
msgid "Install and start Sergio as a permanent service."
msgstr "Instala e inicia Sergio como servicio permanente."

#: sergio servicio instalar --puerto
msgid "Port of the UI/API."
msgstr "Puerto de la interfaz/API."

#: sergio skill
msgid "Manage reusable skills."
msgstr "Gestiona habilidades reutilizables."

#: sergio skill discover
msgid "Mine the trace store for recurring tool sequences and write them as\n    discovered skill manifests under ~/.openjarvis/skills/discovered/."
msgstr "Busca en las trazas secuencias de herramientas que se repiten y las guarda\n    como habilidades descubiertas en ~/.openjarvis/skills/discovered/."

#: sergio skill discover --min-frequency
msgid "Minimum recurrence count to surface a tool sequence as a skill."
msgstr "Mínimo de repeticiones para proponer una secuencia como habilidad."

#: sergio skill discover --min-outcome
msgid "Minimum average outcome score (0.0-1.0) to qualify."
msgstr "Puntuación media mínima (0.0-1.0) para calificar."

#: sergio skill discover --dry-run
msgid "Print discovered patterns without writing manifests."
msgstr "Muestra los patrones encontrados sin escribir manifiestos."

#: sergio skill info
msgid "Show detailed information about a skill."
msgstr "Muestra información detallada de una habilidad."

#: sergio skill install
msgid "Install a skill from a source.\n\n    Example: ``jarvis skill install hermes:apple-notes``"
msgstr "Instala una habilidad desde una fuente.\n\n    Ejemplo: ``jarvis skill install hermes:apple-notes``"

#: sergio skill install --with-scripts
msgid "Import the skill's scripts/ directory (security-sensitive)."
msgstr "Importa la carpeta scripts/ de la habilidad (sensible para la seguridad)."

#: sergio skill install --force
msgid "Overwrite existing install."
msgstr "Sobrescribe la instalación existente."

#: sergio skill install --url
msgid "Repo URL (required when source is 'github')."
msgstr "URL del repositorio (obligatoria si la fuente es 'github')."

#: sergio skill install --yes-dangerous
msgid "Confirm installing an unreviewed skill that requests dangerous capabilities (shell/network-listen/filesystem-write)."
msgstr "Confirma instalar una habilidad sin revisar que pide permisos peligrosos (shell/escucha de red/escritura de archivos)."

#: sergio skill list
msgid "List installed skills."
msgstr "Lista las habilidades instaladas."

#: sergio skill remove
msgid "Remove an installed skill by name.\n\n    Searches ``~/.openjarvis/skills/`` and ``./skills`` for a directory whose\n    name (or parsed manifest name) matches ``skill_name`` and deletes it."
msgstr "Quita una habilidad instalada por su nombre.\n\n    Busca en ``~/.openjarvis/skills/`` y ``./skills`` una carpeta cuyo\n    nombre (o el del manifiesto) coincida con ``skill_name`` y la borra."

#: sergio skill remove --yes
msgid "Skip confirmation prompt."
msgstr "No pide confirmación."

#: sergio skill run
msgid "Execute a stepped skill using configured security and tool permissions."
msgstr "Ejecuta una habilidad por pasos con la seguridad y los permisos configurados."

#: sergio skill run --arg
msgid "Arguments as key=value pairs."
msgstr "Argumentos como pares clave=valor."

#: sergio skill search
msgid "Search available skills across configured sources.\n\n    Matches ``query`` (case-insensitive substring) against skill name,\n    description, and tags."
msgstr "Busca habilidades en las fuentes configuradas.\n\n    Compara ``query`` (sin distinguir mayúsculas, como parte del texto) con el\n    nombre, la descripción y las etiquetas."

#: sergio skill search --source
msgid "Restrict search to a single configured source."
msgstr "Busca solo en una fuente configurada."

#: sergio skill show-overlay
msgid "Show the optimization overlay for a skill, if one exists."
msgstr "Muestra la capa de optimización de una habilidad, si existe."

#: sergio skill sources
msgid "List configured skill sources."
msgstr "Lista las fuentes de habilidades configuradas."

#: sergio skill sync
msgid "Bulk install + update from a source (or all configured sources)."
msgstr "Instala y actualiza en bloque desde una fuente (o todas las configuradas)."

#: sergio skill sync --category
msgid "Filter by category."
msgstr "Filtra por categoría."

#: sergio skill sync --tag
msgid "Filter by tag."
msgstr "Filtra por etiqueta."

#: sergio skill sync --search
msgid "Substring search across name+description."
msgstr "Busca texto en nombre y descripción."

#: sergio skill sync --with-scripts
msgid "Import scripts/ directories."
msgstr "Importa las carpetas scripts/."

#: sergio skill sync --force
msgid "Re-import existing skills."
msgstr "Vuelve a importar las habilidades existentes."

#: sergio skill sync --yes-dangerous
msgid "Confirm installing unreviewed skills that request dangerous capabilities (shell/network-listen/filesystem-write)."
msgstr "Confirma instalar habilidades sin revisar que piden permisos peligrosos (shell/escucha de red/escritura de archivos)."

#: sergio skill update
msgid "Pull latest commits for all installed skill sources."
msgstr "Descarga lo último de todas las fuentes de habilidades instaladas."

#: sergio start
msgid "Start the OpenJarvis server as a background daemon."
msgstr "Inicia el servidor de Sergio como servicio en segundo plano."

#: sergio start --host
msgid "Bind address."
msgstr "Dirección de escucha."

#: sergio start --port
msgid "Port number."
msgstr "Puerto."

#: sergio status
msgid "Show status of the OpenJarvis server daemon."
msgstr "Muestra el estado del servicio del servidor de Sergio."

#: sergio stop
msgid "Stop the running OpenJarvis server daemon."
msgstr "Detiene el servicio del servidor de Sergio."

#: sergio telefono
msgid "Calls and WhatsApp: guided setup and checks."
msgstr "Llamadas y WhatsApp: configuración guiada y comprobaciones."

#: sergio telefono configurar
msgid "Ask for the accounts step by step and save them."
msgstr "Pide las cuentas paso a paso y las guarda."

#: sergio telefono estado
msgid "Show what is configured (never prints secrets)."
msgstr "Muestra lo configurado (nunca muestra secretos)."

#: sergio telefono probar
msgid "Sergio calls you (test call)."
msgstr "Sergio te llama (llamada de prueba)."

#: sergio telemetry
msgid "Query and manage inference telemetry data."
msgstr "Consulta y gestiona los datos de telemetría de inferencia."

#: sergio telemetry clear
msgid "Delete all telemetry records."
msgstr "Borra todos los registros de telemetría."

#: sergio telemetry export
msgid "Export telemetry records."
msgstr "Exporta los registros de telemetría."

#: sergio telemetry export -f
msgid "Output format."
msgstr "Formato de salida."

#: sergio telemetry export -o
msgid "Output file path (default: stdout)."
msgstr "Ruta del archivo de salida (por defecto: la salida estándar)."

#: sergio telemetry stats
msgid "Show aggregated telemetry statistics."
msgstr "Muestra estadísticas agregadas de telemetría."

#: sergio telemetry stats -n
msgid "Number of top models to show."
msgstr "Cuántos modelos principales mostrar."

#: sergio tool
msgid "Manage tools — list, inspect."
msgstr "Gestiona herramientas: listar, inspeccionar."

#: sergio tool inspect
msgid "Show detailed information about a specific tool."
msgstr "Muestra información detallada de una herramienta."

#: sergio tool list
msgid "List all registered tools with their descriptions."
msgstr "Lista todas las herramientas registradas con su descripción."

#: sergio tunnel
msgid "Start a Cloudflare tunnel or manage config."
msgstr "Inicia un túnel de Cloudflare o gestiona su configuración."

#: sergio tunnel --port
msgid "Local port to tunnel."
msgstr "Puerto local a exponer por el túnel."

#: sergio tunnel status
msgid "Show current tunnel configuration."
msgstr "Muestra la configuración actual del túnel."

#: sergio vault
msgid "Manage encrypted credentials."
msgstr "Gestiona credenciales cifradas."

#: sergio vault get
msgid "Retrieve a credential from the vault."
msgstr "Lee una credencial de la bóveda."

#: sergio vault list
msgid "List all stored credential keys."
msgstr "Lista todas las claves de credenciales guardadas."

#: sergio vault remove
msgid "Remove a credential from the vault."
msgstr "Quita una credencial de la bóveda."

#: sergio vault set
msgid "Store a credential in the vault."
msgstr "Guarda una credencial en la bóveda."

#: sergio workflow
msgid "Manage workflows — list, run, status."
msgstr "Gestiona flujos de trabajo: listar, ejecutar, estado."

#: sergio workflow list
msgid "List available workflow definitions."
msgstr "Lista las definiciones de flujos de trabajo disponibles."

#: sergio workflow run
msgid "Run a workflow by name."
msgstr "Ejecuta un flujo de trabajo por su nombre."

#: sergio workflow run --input
msgid "Input text for workflow."
msgstr "Texto de entrada para el flujo de trabajo."

#: sergio workflow status
msgid "Show status of running workflows."
msgstr "Muestra el estado de los flujos de trabajo en marcha."

