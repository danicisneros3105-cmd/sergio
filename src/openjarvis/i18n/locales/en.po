# Sergio's Spanish-first commands, in English

#: help
msgid "Encuentra la causa de un error (ejecuta el comando o lee la traza)."
msgstr "Find the cause of an error (runs the command or reads the traceback)."

#: help
msgid "Archivo con la traza."
msgstr "File with the traceback."

#: help
msgid "Documentación desfasada respecto al código (y docstrings que faltan)."
msgstr "Documentation that drifted from the code (and missing docstrings)."

#: help
msgid "Escribir docstrings que faltan."
msgstr "Write the missing docstrings."

#: help
msgid "Ejecuta un archivo en su lenguaje (Python, JS, TS, Go, Rust, C, C++, Java…)."
msgstr "Run a file in its language (Python, JS, TS, Go, Rust, C, C++, Java…)."

#: help
msgid "Responde sobre un texto enorme (libros, registros, código) con citas."
msgstr "Answer about a huge text (books, logs, code) with citations."

#: help
msgid "Leer todo el texto, no solo lo relevante."
msgstr "Read the whole text, not only the relevant parts."

#: help
msgid "Perfila un script y muestra dónde se va el tiempo."
msgstr "Profile a script and show where the time goes."

#: help
msgid "Renombra un símbolo en todo el proyecto, o no cambia nada."
msgstr "Rename a symbol across the project, or change nothing."

#: help
msgid "Comando de pruebas; si falla, se deshace todo."
msgstr "Test command; if it fails, everything is undone."

#: help
msgid "Revisión de código: errores reales, por gravedad."
msgstr "Code review: real bugs, by severity."

#: help
msgid "Contra qué revisión comparar."
msgstr "Revision to compare against."

#: help
msgid "Escribe primero las pruebas, luego el código, y repite hasta que pasen."
msgstr "Write the tests first, then the code, and repeat until they pass."

#: help
msgid "Dónde guardar el código."
msgstr "Where to save the code."

#: help
msgid "Traduce a otro lenguaje y comprueba que imprime lo mismo."
msgstr "Translate to another language and check it prints the same."

#: help
msgid "Lenguaje de destino."
msgstr "Target language."

#: help
msgid "Entradas de prueba (stdin)."
msgstr "Test inputs (stdin)."

#: help
msgid "Pensar a fondo: reflexión, árbol de ideas, votación, causas, qué-pasaría-si."
msgstr "Think deeply: reflection, tree of thoughts, voting, causes, what-ifs."

#: help
msgid "Qué ha aprendido: mejores estrategias, calibración y niveles de práctica."
msgstr "What it has learned: best strategies, calibration and practice levels."

#: help
msgid "Mejora sus propias instrucciones de razonamiento con problemas de prueba."
msgstr "Improve its own reasoning instructions with test problems."

#: help
msgid "Auto-práctica con problemas que se comprueban solos; sube o baja el nivel."
msgstr "Self-practice with self-checking problems; the level goes up or down."

#: help
msgid "Responde pensando a fondo y dice qué tan seguro está."
msgstr "Answer after deep thinking and say how sure it is."

#: help
msgid "Cómo pensar (auto elige según lo aprendido)."
msgstr "How to think (auto picks from what it learned)."

#: help
msgid "Prueba de verdad: cerebro, voz, oído, pantalla, cámara, caras, globo, manos."
msgstr "Real end-to-end test: brain, voice, hearing, screen, camera, faces, globe, hands."

#: help
msgid "No mover el mouse ni abrir apps."
msgstr "Do not move the mouse or open apps."

#: help
msgid "Programar: TDD, depurar, revisar, documentar, optimizar, 12 lenguajes, refactor seguro."
msgstr "Coding: TDD, debugging, review, docs, optimizing, 12 languages, safe refactors."

#: help
msgid "Markdown a comprobar."
msgstr "Markdown to check."

#: help
msgid "Solo comprobaciones exactas."
msgstr "Exact checks only."

#: help
msgid "Problemas por tema y ronda."
msgstr "Problems per topic and round."

#: help
msgid "Salida JSON."
msgstr "JSON output."

#: sergio pensar preguntar --ver
msgid "Muestra cada paso del razonamiento en vivo."
msgstr "Show every reasoning step live."

msgid "Usar Sergio desde el teléfono: túnel seguro y código QR."
msgstr "Use Sergio from your phone: secure tunnel and QR code."

msgid "Solo muestra el enlace local (misma red)."
msgstr "Only show the local link (same network)."

msgid "Desvincula todos los teléfonos (crea un token nuevo)."
msgstr "Unpair every phone (creates a new token)."

msgid "Muestra si hay un teléfono vinculado y si cloudflared está listo."
msgstr "Show whether a phone is paired and cloudflared is ready."

msgid "Modo Cowork: describa el resultado, aléjese y Sergio hace el resto."
msgstr "Cowork mode: describe the outcome, step away and Sergio does the rest."

msgid "Empieza una tarea Cowork con el resultado que usted quiere."
msgstr "Start a Cowork task with the outcome you want."

msgid "Cuánto hace solo: cauteloso pregunta más, autonomo pregunta menos."
msgstr "How much it does on its own: cauteloso asks more, autonomo asks less."

msgid "Tope de acciones (por defecto 50)."
msgstr "Action cap (default 50)."

msgid "Solo la inicia; véala luego con: sergio cowork estado."
msgstr "Only start it; check it later with: jarvis cowork estado."

msgid "Las tareas Cowork recientes."
msgstr "Recent Cowork tasks."

msgid "Cómo va una tarea (la última si no dice cuál)."
msgstr "How a task is going (the latest if you don't say which)."

msgid "Da el visto bueno a un paso que espera."
msgstr "Approve a step that is waiting."

msgid "Rechaza un paso que espera (no se hace)."
msgstr "Refuse a step that is waiting (it is not done)."

msgid "Detiene una tarea Cowork."
msgstr "Stop a Cowork task."

msgid "El registro completo de lo que decidió e hizo (con su sello de integridad)."
msgstr "The full record of what it decided and did (with its integrity seal)."

msgid "Plugins: herramientas nuevas para Sergio, hechas por otras personas."
msgstr "Plugins: new tools for Sergio, made by other people."

msgid "Busca plugins en los índices."
msgstr "Search the plugin indexes."

msgid "Instala un plugin por nombre, desde un .zip o desde una URL https."
msgstr "Install a plugin by name, from a .zip or from an https URL."

msgid "No preguntar (acepta los permisos)."
msgstr "Do not ask (accept the permissions)."

msgid "Reinstala aunque ya esté esa versión."
msgstr "Reinstall even if that version is already installed."

msgid "Huella esperada del archivo."
msgstr "Expected SHA-256 of the file."

msgid "Quita un plugin y sus archivos."
msgstr "Remove a plugin and its files."

msgid "Detalles de un plugin (instalado o del índice)."
msgstr "Details of a plugin (installed or from the index)."

msgid "Los plugins instalados."
msgstr "Installed plugins."

msgid "Vuelve a usar un plugin desactivado."
msgstr "Use a disabled plugin again."

msgid "Deja de usar un plugin sin desinstalarlo."
msgstr "Stop using a plugin without uninstalling it."

msgid "Crea el esqueleto de un plugin nuevo, listo para editar."
msgstr "Create a ready-to-edit skeleton for a new plugin."

msgid "Dónde crearlo."
msgstr "Where to create it."

msgid "Empaqueta una carpeta de plugin en un .zip con su huella sha256."
msgstr "Pack a plugin folder into a .zip with its SHA-256."

msgid "Carpeta del .zip."
msgstr "Folder for the .zip."

msgid "Copias de seguridad cifradas (carpeta, S3/B2 o SFTP)."
msgstr "Encrypted backups (folder, S3/B2 or SFTP)."

msgid "Elige dónde guardar las copias y comprueba que funciona."
msgstr "Choose where backups go and check that it works."

msgid "Copia completa aunque haya una anterior."
msgstr "Full backup even if there is an earlier one."

msgid "No incluye sergio.env ni tokens."
msgstr "Leave out sergio.env and tokens."

msgid "Hace una copia cifrada ahora (incremental si ya hay una)."
msgstr "Make an encrypted backup now (incremental if there is one already)."

msgid "Las copias que hay en el destino."
msgstr "The backups on the target."

msgid "Carpeta donde restaurar."
msgstr "Folder to restore into."

msgid "Reemplaza ~/.openjarvis (guarda la actual aparte)."
msgstr "Replace ~/.openjarvis (the current one is kept aside)."

msgid "Restaura una copia (la última si no dice cuál)."
msgstr "Restore a backup (the latest if you don't say which)."

msgid "Descifra una copia y comprueba cada archivo, sin restaurar nada."
msgstr "Decrypt a backup and check every file, without restoring anything."

msgid "Sincroniza ahora (trae lo nuevo de otros equipos y sube lo suyo)."
msgstr "Sync now (bring what other devices changed, send what this one changed)."

msgid "Elige el destino compartido y desbloquea este equipo."
msgstr "Choose the shared target and unlock this device."

msgid "Este equipo, el destino y la última sincronización."
msgstr "This device, the target and the last sync."

msgid "Este equipo olvida la clave (deja de sincronizar hasta configurarlo de nuevo)."
msgstr "This device forgets the key (stops syncing until set up again)."

msgid "Sincroniza memoria, skills y notas entre sus equipos (cifrado de extremo a extremo)."
msgstr "Sync memory, skills and notes between your devices (end-to-end encrypted)."

msgid "Los planes de Sergio y el que usted tiene."
msgstr "Sergio's plans and the one you have."

msgid "Abre la página de pago del plan elegido."
msgstr "Open the payment page for the chosen plan."

msgid "Claves de licencia de los planes de pago."
msgstr "License keys for the paid plans."

msgid "Activa una clave de licencia en este equipo."
msgstr "Activate a license key on this device."

msgid "Qué plan tiene este equipo y hasta cuándo."
msgstr "Which plan this device has and until when."

msgid "Quita la licencia de este equipo (vuelve a Free)."
msgstr "Remove the license from this device (back to Free)."

msgid "(Vendedor) Crea el par de claves con que se firman las licencias."
msgstr "(Seller) Create the key pair that signs licenses."

msgid "Archivo para la clave privada."
msgstr "File for the private key."

msgid "(Vendedor) Firma una licencia para un cliente."
msgstr "(Seller) Sign a license for a customer."

msgid "A nombre de quién."
msgstr "Whose name it is in."

msgid "Usuarios (Teams/Enterprise)."
msgstr "Users (Teams/Enterprise)."

msgid "Días de validez."
msgstr "Days it is valid."

msgid "Archivo de la clave privada."
msgstr "The private key file."

msgid "Veces el uso de Free que eligió (Dev 10-23, Founders 25-60)."
msgstr "Times of Free's use you chose (Dev 10-23, Founders 25-60)."

#: help
msgid "Sergio en Windows: compañero junto al cursor, voz y control de pantalla."
msgstr "Sergio on Windows: a companion next to the cursor, voice and screen control."

#: help
msgid "Instala o actualiza Sergio Escritorio en Windows."
msgstr "Install or update Sergio Escritorio on Windows."

#: help
msgid "Descarga también el modelo local de visión (qwen2.5vl:7b, ~6 GB) para describir imágenes en pantalla."
msgstr "Also download the local vision model (qwen2.5vl:7b, ~6 GB) to describe images on screen."

#: help
msgid "Descarga también las librerías NVIDIA (~1 GB) para escuchar con el modelo grande de Whisper en la tarjeta gráfica."
msgstr "Also download the NVIDIA libraries (~1 GB) to listen with the large Whisper model on the graphics card."

#: help
msgid "Actualiza Sergio Escritorio en Windows."
msgstr "Update Sergio Escritorio on Windows."

#: help
msgid "Descarga también el modelo local de visión."
msgstr "Also download the local vision model."

#: help
msgid "Descarga librerías NVIDIA para Whisper."
msgstr "Download NVIDIA libraries for Whisper."

#: help
msgid "Comprueba que Sergio pueda comunicarse con Sergio Escritorio."
msgstr "Check that Sergio can talk to Sergio Escritorio."

#: help
msgid "Instala un plugin por nombre, desde un .zip, una URL https o\n    «nombre@marketplace» (formato de Claude)."
msgstr "Install a plugin by name, from a .zip, an https URL or\n    «name@marketplace» (Claude format)."

#: help
msgid "Los plugins de sus marketplaces (formato de Claude)."
msgstr "The plugins in your marketplaces (Claude format)."

#: help
msgid "Solo este marketplace."
msgstr "Only this marketplace."

#: help
msgid "Marketplaces de plugins (repositorios con .claude-plugin/marketplace.json)."
msgstr "Plugin marketplaces (repositories with .claude-plugin/marketplace.json)."

#: help
msgid "Añade un marketplace: «propietario/repo», URL git o carpeta."
msgstr "Add a marketplace: «owner/repo», a git URL or a folder."

#: help
msgid "Los marketplaces añadidos."
msgstr "The marketplaces you added."

#: help
msgid "Trae la última versión de un marketplace."
msgstr "Fetch the latest version of a marketplace."

#: help
msgid "Quita un marketplace (los plugins instalados se quedan)."
msgstr "Remove a marketplace (installed plugins stay)."

#: help
msgid "Conectores MCP (como en Claude): añadir, conectar, permisos, servir."
msgstr "MCP connectors (as in Claude): add, connect, permissions, serve."

#: help
msgid "Añade un conector: una URL (remoto), una orden tras «--» (local),\n    o solo el nombre si está en el directorio."
msgstr "Add a connector: a URL (remote), a command after «--» (local),\n    or just the name if it is in the directory."

#: help
msgid "KEY=valor para un servidor local."
msgstr "KEY=value for a local server."

#: help
msgid "«Nombre: valor» para un servidor remoto."
msgstr "«Name: value» for a remote server."

#: help
msgid "Client ID propio (servicios sin registro automático)."
msgstr "Your own Client ID (services without automatic registration)."

#: help
msgid "Secreto de ese Client ID, si lo tiene."
msgstr "Secret of that Client ID, if it has one."

#: help
msgid "Variable privada KEY=valor."
msgstr "Private variable KEY=value."

#: help
msgid "Añade un conector desde su JSON (el mismo formato de .mcp.json)."
msgstr "Add a connector from its JSON (the same format as .mcp.json)."

#: help
msgid "Trae los servidores MCP que ya tiene en Claude Desktop."
msgstr "Bring in the MCP servers you already have in Claude Desktop."

#: help
msgid "Sus conectores y si responden."
msgstr "Your connectors and whether they respond."

#: help
msgid "No comprobar la conexión."
msgstr "Do not check the connection."

#: help
msgid "Detalles de un conector."
msgstr "Details of a connector."

#: help
msgid "El directorio de conectores listos para añadir."
msgstr "The directory of connectors ready to add."

#: help
msgid "Conecta (inicia sesión en el servicio si lo pide)."
msgstr "Connect (sign in to the service if it asks)."

#: help
msgid "Cierra la sesión (el conector se queda)."
msgstr "Sign out (the connector stays)."

#: help
msgid "Quita un conector y su sesión."
msgstr "Remove a connector and its session."

#: help
msgid "Las herramientas de un conector y su permiso."
msgstr "A connector's tools and their permission."

#: help
msgid "Usa una herramienta a mano (cuenta como aprobada; «Nunca» la bloquea)."
msgstr "Use a tool by hand (counts as approved; «Never» blocks it)."

#: help
msgid "Permiso de una herramienta («*» = todas): allow, ask o block."
msgstr "Permission of a tool («*» = all): allow, ask or block."

#: help
msgid "Sirve las herramientas de Sergio por MCP (stdio), para Claude u otros.\n\n    En Claude Desktop: {{\"mcpServers\": {{\"sergio\": {{\"command\": \"sergio\", \"args\": [\"mcp\", \"serve\"]}}}}}}"
msgstr "Serve Sergio's tools over MCP (stdio), for Claude or others.\n\n    In Claude Desktop: {{\"mcpServers\": {{\"sergio\": {{\"command\": \"sergio\", \"args\": [\"mcp\", \"serve\"]}}}}}}"

#: help
msgid "Solo estas herramientas (separadas por comas)."
msgstr "Only these tools (comma-separated)."

#: help
msgid "Biblioteca de prompts: colecciones públicas de prompts de sistema y de personaje."
msgstr "Prompt library: public collections of system and persona prompts."

#: help
msgid "Descarga completas las colecciones y rehace el índice local."
msgstr "Downloads the collections in full and rebuilds the local index."

#: help
msgid "Qué hay instalado y de dónde viene."
msgstr "What is installed and where it comes from."

#: help
msgid "Muestra los fragmentos que traería una petición."
msgstr "Shows the passages a request would bring in."
