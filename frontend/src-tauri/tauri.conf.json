{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sergio Studio",
  "version": "1.0.0",
  "identifier": "com.sergiostudio.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../src/openjarvis/server/static_local"
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "category": "Video",
    "copyright": "2026 Sergio Studio",
    "targets": "all",
    "externalBin": ["sergio", "openclacky"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "app": {
    "security": {
      "csp": null,
      "capabilities": ["desktop-capability", "mobile-capability", "main-capability"]
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 780,
        "resizable": true,
        "title": "Sergio Studio",
        "width": 1200,
        "minWidth": 375,
        "minHeight": 667
      }
    ]
  },
  "plugins": {
    "fs": {
      "scope": ["**", "$APPDATA/**", "$DOCUMENT/**", "$DOWNLOAD/**", "$PICTURE/**", "$VIDEO/**", "$DESKTOP/**", "$HOME/**"]
    },
    "dialog": {},
    "shell": {
      "open": true,
      "scope": [
        {"name": "blender", "cmd": "blender", "args": true},
        {"name": "ffmpeg", "cmd": "ffmpeg", "args": true},
        {"name": "ffprobe", "cmd": "ffprobe", "args": true},
        {"name": "open", "cmd": "open", "args": true},
        {"name": "xdg-open", "cmd": "xdg-open", "args": true}
      ]
    },
    "upload": {},
    "clipboard-manager": {},
    "global-shortcut": {},
    "notification": {},
    "os": {},
    "process": {},
    "updater": {
      "active": true,
      "endpoints": ["https://api.github.com/repos/danicisneros3105-cmd/sergio/releases/latest"],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ5NEMzM0E0ODAwQjAzNDEKUldRbUtvK2t6c2x1R3Z0N2Z6ZmRXaGZnK1VQVWZMc2ZFNzJFZ0d5Rm5rMDZIbHh4RGZzM3I1dXgK"
    }
  }
}