{
  "identifier": "mobile-capability",
  "description": "Permisos para acceso al dispositivo en dispositivos moviles via Capacitor bridge",
  "windows": ["main"],
  "platforms": ["iOS", "android"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-listen",
    "core:window:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-set-size",
    "core:window:allow-set-focus",
    "shell:allow-open",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "dialog:allow-message",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-copy-file",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-mkdir",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA" },
        { "path": "$APPDATA/**" },
        { "path": "$DOCUMENT" },
        { "path": "$DOCUMENT/**" },
        { "path": "$PICTURE" },
        { "path": "$PICTURE/**" },
        { "path": "$VIDEO" },
        { "path": "$VIDEO/**" },
        { "path": "$TEMP/**" }
      ]
    },
    "upload:allow-download",
    "upload:allow-upload",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "notification:default",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-show",
    "os:allow-platform",
    "os:allow-version",
    "os:allow-os-type",
    "process:allow-restart",
    "process:allow-exit"
  ]
}
